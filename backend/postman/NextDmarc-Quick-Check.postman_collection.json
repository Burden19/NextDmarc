{
  "info": {
    "name": "NextDmarc Backend Quick Check",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Quick supervisor demo collection for backend health, auth, core CRUD, pipeline trigger, and analytics."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "domainId",
      "value": ""
    },
    {
      "key": "mailboxId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 Register Tenant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_name\": \"Acme Corp\",\n  \"admin_email\": \"admin@acme.test\",\n  \"admin_password\": \"Password!123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register-tenant",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register-tenant"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  var data = pm.response.json();",
              "  pm.collectionVariables.set('tenantId', data.tenant_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@acme.test\",\n  \"password\": \"Password!123\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  var data = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create Domain",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          },
          {
            "key": "X-Role",
            "value": "client_admin"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "disabled": true
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fqdn\": \"example.com\",\n  \"dmarc_policy\": \"none\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/domains",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "domains"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  var data = pm.response.json();",
              "  pm.collectionVariables.set('domainId', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 List Domains",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          },
          {
            "key": "X-Role",
            "value": "client_admin"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/domains",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "domains"
          ]
        }
      }
    },
    {
      "name": "06 Create Mailbox",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          },
          {
            "key": "X-Role",
            "value": "client_admin"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Primary\",\n  \"username\": \"collector@example.test\",\n  \"password\": \"secret\",\n  \"server\": \"imap.example.test\",\n  \"mailbox\": \"INBOX\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/mailboxes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "mailboxes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  var data = pm.response.json();",
              "  pm.collectionVariables.set('mailboxId', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Trigger Collect",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          },
          {
            "key": "X-Role",
            "value": "client_admin"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/mailboxes/{{mailboxId}}/trigger-collect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "mailboxes",
            "{{mailboxId}}",
            "trigger-collect"
          ]
        }
      }
    },
    {
      "name": "08 List Reports",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          },
          {
            "key": "X-Role",
            "value": "analyst_soc"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reports?page=1&page_size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reports"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "09 Analytics Conformance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          },
          {
            "key": "X-Role",
            "value": "analyst_soc"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/analytics/conformance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "analytics",
            "conformance"
          ]
        }
      }
    }
  ]
}
